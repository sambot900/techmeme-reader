{
  "expo": {
    "name": "Techmeme Reader",
    "slug": "techmeme-reader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/techmemelogo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/techmemelogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F0F"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/techmemelogo.png",
        "backgroundColor": "#0F0F0F"
      },
      "package": "com.techmemereader",
      "versionCode": 1,
      "permissions": ["INTERNET"]
    },
    "plugins": [
      "expo-font"
    ]
  }
}
